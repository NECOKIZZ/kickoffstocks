# Kickoff Stocks. Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# Which chain the app and keeper use: testnet (default) | mainnet | local
LEAGUE_CHAIN=testnet
# RPCs. Public ones are rate-limited; use a provider (Alchemy, QuickNode…) for production.
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Chainlink feeds live on mainnet only: testnet rounds read the same stocks' mainnet feeds here.
PRICE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# chainlink (default, verifiable on-chain) | robinhood (Robinhood's quote API, for short demo rounds)
LEAGUE_PRICE_SOURCE=chainlink

# The league contract (printed by scripts/deploy.mts, saved in deployments.json)
ESCROW_ADDRESS=

# Deployer = owner. Use the same deployer as Kickoff's escrows so both read as one project.
DEPLOYER_PRIVATE_KEY=
# Keeper = settles rounds. A separate wallet, so it never races Kickoff's own transactions.
KEEPER_PRIVATE_KEY=
KEEPER_ADDRESS=

# Mainnet only: a USDG ERC-4626 savings vault for idle tickets (Robinhood Earn / Morpho)
YIELD_VAULT=
# Mainnet only: "Buy the ETF" through 0x (https://dashboard.0x.org). Server side only.
ZEROEX_API_KEY=

# Where the keeper keeps price samples and published settlement inputs
LEAGUE_DATA_DIR=data
PUBLIC_ORIGIN=https://stocks.kickoff.cash
