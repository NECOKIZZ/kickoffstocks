{
  "name": "kickoff-stocks",
  "version": "0.1.0",
  "private": true,
  "description": "Kickoff Stocks: Kickoff's stock league on Robinhood Chain. Build an ETF from Robinhood Stock Tokens and beat AVERAGE.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:contracts": "cd contracts && forge test",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start -p 8080",
    "dev:8080": "next dev -p 8080",
    "keeper": "tsx --env-file-if-exists=.env.local scripts/keeper.mts",
    "deploy:league": "tsx --env-file-if-exists=.env.local scripts/deploy.mts",
    "local-demo": "tsx scripts/local-demo.mts",
    "verify": "tsx --env-file-if-exists=.env.local scripts/verify.mts",
    "add:crypto": "tsx --env-file-if-exists=.env.local scripts/add-crypto.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.52.0",
    "next": "^16.2.10",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "viem": "^2.55.8",
    "wagmi": "^3.7.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
